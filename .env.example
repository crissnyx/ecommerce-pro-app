# =========================
# App / Server
# =========================
# Port where Streamlit runs (default 8501)
STREAMLIT_SERVER_PORT=8501

# Optional: Set to "production" in a deployed environment
ENVIRONMENT=development

# =========================
# Simulator / Ingest
# =========================
# If USE_SIMULATOR=true, the repo emits synthetic transactions for demo
USE_SIMULATOR=true
SIMULATOR_RATE_PER_MINUTE=30     # transactions/minute (simulated)

# =========================
# Forecasting
# =========================
# Forecast horizon in days (7, 14, 30)
FORECAST_HORIZON_DAYS=30
# Random seed for reproducible Prophet runs
PROPHET_SEED=42

# =========================
# Storage (default: CSV/SQLite)
# =========================
# Choose: csv | sqlite | postgres
STORAGE_BACKEND=csv
# When using sqlite, set the file path (relative to repo)
SQLITE_FILE=./data/db.sqlite
# When using Postgres, set full connection URL (optional)
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# =========================
# Shopify (optional)
# =========================
# To enable real Shopify ingestion set USE_SHOPIFY=true and fill keys
USE_SHOPIFY=false
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# =========================
# Stripe (optional)
# =========================
USE_STRIPE=false
STRIPE_API_KEY=

# =========================
# Webhooks / Alerts (optional)
# =========================
# Example: https://hooks.slack.com/services/XXX/YYY/ZZZ
WEBHOOK_URL_SLACK=
# Example: https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
WEBHOOK_URL_DISCORD=
# A small threshold (percentage) that triggers revenue alerts, e.g. 0.15 = 15%
REVENUE_DROP_THRESHOLD_PERCENT=0.15

# =========================
# Twilio (optional SMS/WhatsApp)
# =========================
USE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1987654321

# =========================
# Logging & Monitoring
# =========================
LOG_LEVEL=INFO
SENTRY_DSN=            # optional: e.g. https://public@sentry.io/12345

# =========================
# Misc / Security
# =========================
# Toggle verbose debug UI (do not enable in production)
DEBUG_UI=false

# =========================
# Notes
# - Copy this file to `.env` and fill in secrets for real integrations.
# - Use a secrets manager for production; never commit `.env` with secrets.
# - For local development you can keep USE_SIMULATOR=true to avoid external APIs.